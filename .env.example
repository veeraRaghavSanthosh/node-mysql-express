# Environment Configuration Example
# Copy this file to .env and update with your actual values

# Database Configuration
DB_HOST=localhost
DB_USER=your_database_username
DB_PASSWORD=your_database_password
DB_NAME=your_database_name

# JWT Configuration
JWT_SECRET=your-very-strong-secret-key-here-at-least-32-characters-long
JWT_EXPIRES_IN=24h

# Server Configuration
PORT=3000
NODE_ENV=development

# Optional: Database Connection Pool Settings
DB_CONNECTION_LIMIT=10
DB_ACQUIRE_TIMEOUT=60000
DB_TIMEOUT=60000

# Optional: Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_ATTEMPTS=5

# Optional: CORS Configuration
CORS_ORIGIN=*
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_HEADERS=Origin,X-Requested-With,Content-Type,Accept,Authorization

# Optional: Logging Configuration
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Security Headers (for production)
HELMET_ENABLED=true
TRUST_PROXY=false

# Session Configuration (if using sessions)
SESSION_SECRET=your-session-secret-key
SESSION_MAX_AGE=86400000

# Email Configuration (for future features like password reset)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-email-password
EMAIL_FROM=noreply@yourapp.com

# File Upload Configuration (if needed)
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif

# Redis Configuration (for caching or session store)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# API Documentation
API_DOCS_ENABLED=true
API_DOCS_PATH=/api-docs

# Monitoring and Health Checks
HEALTH_CHECK_ENABLED=true
METRICS_ENABLED=false

# Third-party Integrations
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# Webhook URLs
WEBHOOK_URL=https://your-webhook-endpoint.com/webhook
WEBHOOK_SECRET=your-webhook-secret

# Development vs Production Settings
# For development, you might want to set:
# NODE_ENV=development
# JWT_EXPIRES_IN=7d
# LOG_LEVEL=debug

# For production, you should set:
# NODE_ENV=production
# JWT_EXPIRES_IN=1h
# LOG_LEVEL=warn
# HELMET_ENABLED=true
# TRUST_PROXY=true