{
  "name": "node-mysql-express-examples",
  "version": "1.0.0",
  "description": "Usage examples for node-mysql-express library in JavaScript and TypeScript",
  "main": "javascript-usage.js",
  "scripts": {
    "start": "node javascript-usage.js",
    "start:ts": "npx ts-node typescript-usage.ts",
    "build": "npx tsc typescript-usage.ts --outDir dist",
    "build:run": "npm run build && node dist/typescript-usage.js",
    "dev": "nodemon javascript-usage.js",
    "dev:ts": "nodemon --exec \"npx ts-node\" typescript-usage.ts"
  },
  "keywords": [
    "nodejs",
    "express",
    "mysql",
    "restapi",
    "typescript",
    "javascript",
    "crud",
    "examples"
  ],
  "author": "veera",
  "license": "ISC",
  "dependencies": {
    "body-parser": "^1.19.0",
    "express": "^4.17.1",
    "mysql": "^2.17.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.13",
    "@types/mysql": "^2.15.21",
    "@types/node": "^16.11.7",
    "nodemon": "^2.0.15",
    "ts-node": "^10.4.0",
    "typescript": "^4.5.2"
  },
  "engines": {
    "node": ">=8.0.0"
  }
}