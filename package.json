{
  "name": "node-mysql-express",
  "version": "1.2.0",
  "description": "A Node.js Express application with MySQL integration featuring comprehensive TypeScript and JavaScript examples",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:js": "jest tests/javascript-tests.test.js",
    "test:ts": "jest tests/typescript-tests.test.ts",
    "build:ts": "tsc examples/typescript-usage.ts --outDir dist --target es2018 --module commonjs --esModuleInterop --resolveJsonModule",
    "example:js": "node examples/javascript-usage.js",
    "example:ts": "ts-node examples/typescript-usage.ts"
  },
  "keywords": [
    "nodejs",
    "express",
    "mysql",
    "typescript",
    "javascript",
    "rest-api",
    "crud",
    "database"
  ],
  "author": "veeraRaghavSanthosh",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "mysql2": "^3.6.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.5",
    "@types/node": "^20.6.0",
    "@types/supertest": "^2.0.12",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "examples/**/*.{js,ts}",
      "!examples/**/*.test.{js,ts}"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": ["text", "lcov", "html"],
    "testMatch": [
      "**/tests/**/*.test.{js,ts}"
    ],
    "preset": "ts-jest/presets/js-with-ts",
    "moduleFileExtensions": ["js", "ts"],
    "transform": {
      "^.+\\.ts$": "ts-jest",
      "^.+\\.js$": "babel-jest"
    }
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/veeraRaghavSanthosh/node-mysql-express.git"
  }
}