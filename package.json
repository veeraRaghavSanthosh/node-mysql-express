{
  "name": "node-mysql-express",
  "version": "1.0.0",
  "description": "Node.js Express MySQL API with comprehensive authentication testing",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:auth": "jest tests/auth",
    "test:verbose": "jest --verbose"
  },
  "dependencies": {
    "express": "^4.18.0",
    "body-parser": "^1.20.0",
    "mysql": "^2.18.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "@types/jest": "^29.5.5",
    "nodemon": "^3.0.1"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "**/*.js",
      "!node_modules/**",
      "!coverage/**",
      "!jest.config.js"
    ],
    "testMatch": [
      "**/tests/**/*.test.js",
      "**/__tests__/**/*.js",
      "**/?(*.)+(spec|test).js"
    ],
    "coverageReporters": ["text", "lcov", "html"],
    "coverageDirectory": "coverage"
  },
  "keywords": [
    "nodejs",
    "express",
    "mysql",
    "api",
    "authentication",
    "testing"
  ],
  "author": "Developer",
  "license": "MIT"
}