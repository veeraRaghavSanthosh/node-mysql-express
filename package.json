{
  "name": "node-mysql-express-migrations",
  "version": "1.0.0",
  "description": "Database migrations for Node.js MySQL Express application",
  "main": "index.js",
  "scripts": {
    "migrate:up": "node migrations/migration-runner.js up",
    "migrate:down": "node migrations/migration-runner.js down",
