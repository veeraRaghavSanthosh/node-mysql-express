{
  "name": "node-mysql-express-billing",
  "version": "1.0.0",
  "description": "Node.js Express MySQL Billing API with comprehensive documentation and testing",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "express": "^4.18.0",
    "mysql": "^2.18.0",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "jest": "^29.0.0",
    "supertest": "^6.3.0",
    "nodemon": "^2.0.20"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "app/**/*.js",
      "server.js",
      "!app/config/*.js"
    ]
  },
  "keywords": [
    "nodejs",
    "express",
    "mysql",
    "api",
    "billing",
    "customer-management"
  ],
  "author": "Development Team",
  "license": "MIT"
}