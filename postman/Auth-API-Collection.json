        {
          "name": "No Authorization Header",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/profile",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "profile"]
            },
            "description": "Example of missing authorization header"
          },
          "response": []
        }
      ]
    },
    {
